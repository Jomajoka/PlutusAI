CORS_ALLOWED_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Any OpenAI-compatible chat completions endpoint (OpenRouter, Groq, etc).
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# Comma-separated, tried in order as a fallback chain.
LLM_STRUCTURING_MODELS=llama-3.1-8b-instant
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html -- used for
# inflation (CPI) context in scenario narration. Optional: that feature is
# just skipped if this is blank.
FRED_API_KEY=your-fred-api-key
